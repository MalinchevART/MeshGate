# MeshGate — примерна конфигурация за deploy/.env (генерирай: bash deploy/gen-env.sh)
# НИТО ЕДНА стойност не се комитва.

# --- PostgreSQL (вътрешен за compose мрежата; портът не се публикува) ---
POSTGRES_USER=meshgate
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=meshgate

# --- MeshGate API ---
MESHGATE_SECRET_KEY=CHANGE_ME_random
# Начална парола за първо влизане (по подразбиране P@sswordG@te; смени я след вход —
# UI и meshgate.cmd ще предложат). Важно при публично достъпна инсталация.
MESHGATE_ADMIN_USER=admin
MESHGATE_ADMIN_PASSWORD=P@sswordG@te

# --- EMQX 5.8.x (ADR-001) ---
# Dashboard парола — ползва се САМО от api adapter-а (вътрешна мрежа, порт 18083 не се публикува)
EMQX_DASHBOARD_PASSWORD=CHANGE_ME
# Ingest клиентът на MeshGate (superuser за wildcard subscription)
EMQX_INGEST_USER=meshgate-ingest
EMQX_INGEST_PASSWORD=CHANGE_ME

# --- Публикувани портове ---
# MQTT TCP на брокера (устройствата); TLS listener + ACME — при продукционна фаза
# 80 (Traefik) е фиксиран в compose; 1883 също. Нищо друго не излиза навън.

# --- Демо емулатор (профил "demo"; api подготвя MQTT потребителя) ---
MESHGATE_EMULATOR_USER=meshgate-emulator
MESHGATE_EMULATOR_PASSWORD=CHANGE_ME
EMULATOR_NODES=6
EMULATOR_INTERVAL=5

# --- Retention (дни) ---
RETENTION_PACKETS_RAW=14
RETENTION_EVENTS=365

# --- SMTP за имейл известия (Фаза 5; празен host = имейл каналите дават ясна грешка) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=meshgate@example.com
